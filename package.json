{
  "name": "obsidian-export-img",
  "version": "1.0.9",
  "description": "Export Obsidian notes as images approximating Reading view.",
  "main": "main.js",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "check:plugin": "obsidian-plugin-validator .",
    "verify": "tsc -noEmit -skipLibCheck && pnpm run check:plugin && node scripts/run-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "prepare": "husky"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "export",
    "image"
  ],
  "author": "Egoism(379949990)",
  "homepage": "https://github.com/379949990",
  "license": "MIT",
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "obsidian": "latest",
    "obsidian-plugin-validator": "^1.0.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "modern-screenshot": "^4.6.0",
    "preact": "^10.26.9"
  }
}
